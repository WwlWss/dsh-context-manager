{
  "name": "dsh-context-manager",
  "version": "0.1.0-alpha.0",
  "description": "Modular preset, prompt, and skill context manager for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "tsdown --config tsdown.config.ts",
    "prepare": "tsdown --config tsdown.prepare.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test ./tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run clean && pnpm run build && pnpm run test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WwlWss/dsh-context-manager.git"
  },
  "bugs": {
    "url": "https://github.com/WwlWss/dsh-context-manager/issues"
  },
  "homepage": "https://github.com/WwlWss/dsh-context-manager#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
